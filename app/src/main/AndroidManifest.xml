<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" /> <!-- Allows the app to open network sockets -->
    <uses-permission android:name="android.permission.INTERNET" /> <!-- Allows the app to write to the built-in SD card -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" /> <!-- Allows the app to access network status -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" /> <!-- Allows the app to access Wi-Fi network information -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" /> <!-- Allows the app to access CellID or Wi-Fi hotspots to obtain precise location -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" /> <!-- Special permissions required for Huawei devices -->
    <uses-permission android:name="com.huawei.android.launcher.permission.CHANGE_BADGE" />
    <uses-permission android:name="com.huawei.permission.external_app_settings.USE_COMPONENT" />
    <uses-permission android:name="com.huawei.android.launcher.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <application
        android:name=".MyApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DavidDeer"
        tools:targetApi="31">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".activities.GalleryActivity"
            android:exported="false" />

        <service
            android:name=".service.StepsSensorService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="e17f3d8b78c7bd26e1f8884b32a5a129"
            tools:ignore="ExtraText">

            <!-- AMAP API KEY -->
        </meta-data>

        <activity android:name=".activities.MainActivity" />
        <activity android:name=".activities.BestiaryActivity" />
        <activity android:name=".activities.MapActivity" />
        <activity android:name=".activities.GameActivity" />
        <activity android:name=".activities.LevelOneActivity" />
        <activity android:name=".activities.LevelTwoActivity" />
        <activity android:name=".activities.StepsActivity" />
        <activity android:name=".activities.GoalSettingActivity" />
        <activity android:name=".activities.SelectBeastActivity" />
        <activity android:name=".activities.GuideActivity" />
        <activity android:name=".activities.LoginActivity" />
        <activity android:name=".activities.RegisterActivity" />
        <activity android:name=".activities.ForgotPasswordActivity" />
        <activity
            android:name=".activities.StartActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>